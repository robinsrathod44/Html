<!DOCTYPE html>

<head>
    <title>Insta</title>
</head>
<style>
    *{
    margin: 0%;
    padding: 0%;
}
body{
    background-color: rgb(0,0, 0);
   
}

h1{
  text-align: center;
    color: #ffffff;
}
.logo{
    
    width: 500px;
    height: 500px;
    margin: auto;
    position: relative;
}
.instagram{
    width: 50%;
    height: 50%;
    position: relative;
    background: radial-gradient(circle at 25% 109%,
    #f2e665 0%,
    #f2e665 15%, 
    #f04b4a 45%,
    #d52bb1 60%,
    #5748db 87%);
border-radius: 20%;                                                                                                                                                                                                                                                                                                                                                                                                                                     
left:25%;
top: 25%;
}
.outline{
    width: 60%;
    height: 60%;
    position: absolute;          
    top:13%;
    left:13.5%;
    border-radius: 20%;
    border: 18px solid #ffffff;
}
.inside{
    width: 40%;
    height: 40%;
    border-radius: 50%;
    position: absolute;
    left:18%;
    top:20%;
    border: 18px solid #ffffff;
}
.circle{
    background-color: #ffffff;
    width: 7%;
    height: 7%;
    border-radius: 50%;
    position: relative;
    left: 76%;
    top:7%;
    border: 5px solid #ffffff;
}
</style>

<body>
    <br>
    <br>
    <h1><b><u><i>Instagram Logo</i></u></b></h1><br><br>
    
    
    <div class="logo">
        <div class="instagram">
            <div class="outline">
                <div class="inside"></div>
                <div class="circle"></div>
            </div>
        </div>
    </div>
    
</body>
        
</html>
